# macOS
.DS_Store

# Python-generated files
__pycache__/
*.py[cod]
wheels/
*.egg-info

# Local artifacts, except EPUBs and audiobook files tracked with Git LFS
/artifacts/*
!/artifacts/sources/
/artifacts/sources/*
!/artifacts/sources/*.epub
!/artifacts/site/
/artifacts/site/*
!/artifacts/site/*.epub
!/artifacts/site/audio/
/artifacts/site/audio/*
!/artifacts/site/audio/*.webm

# Local environments and downloaded models
.venv/
.cache/
node_modules/
.wrangler/
.dev.vars
.env
.env.*
!.env.example
